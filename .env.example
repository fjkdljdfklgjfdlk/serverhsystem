# Backend secrets only. Never upload this file filled in, or .env, to GitHub Pages.
PORT=8787
HOST=127.0.0.1
# Exact browser origin, no path. GitHub project path does not belong here.
PUBLIC_ORIGIN=http://localhost:8787
ROBLOX_API_KEY=
# Needed for group kick / group ban / group unban only. Paste the VALUE, not .ROBLOSECURITY=.
ROBLOX_COOKIE=
# Account whose credentials perform the actions; protected from panel actions.
BOT_USER_ID=
DATABASE_PATH=./data/serverh.sqlite
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
# Used by Docker Compose / Caddy for automatic HTTPS. DNS must point to your host.
API_DOMAIN=control-api.example.com
