# Template only. Actual credentials belong in /opt/serverh-control/.env on the VPS.
# Exact browser origins, no paths or trailing slash. PUBLIC_ORIGINS takes precedence.
PUBLIC_ORIGINS=https://fjkdljdfklgjfdlk.github.io,https://serverh.uhbacon.cloud
# Backwards-compatible single-origin setting, used only if PUBLIC_ORIGINS is empty.
PUBLIC_ORIGIN=https://serverh.uhbacon.cloud
ROBLOX_API_KEY=
ROBLOX_COOKIE=
# Public bot account ID. Cookie is verified against this account before group actions.
BOT_USER_ID=11919015367
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/serverh.sqlite
# compose.vps.yaml overrides this to 1 behind the Nginx proxy which overwrites XFF.
TRUST_PROXY=0
# Used only by the alternative standalone Caddy deployment in compose.yaml.
API_DOMAIN=serverh.uhbacon.cloud
